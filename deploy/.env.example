# Замените пароль на уникальный случайный секрет до запуска.
POSTGRES_PASSWORD=
POSTGRES_USER=deploycore
POSTGRES_DB=deploycore
DEPLOYCORE_HTTPS_BIND=127.0.0.1
DEPLOYCORE_HTTPS_PORT=8443
# Путь относительно deploy/ или абсолютный.
DEPLOYCORE_TLS_DIR=./tls

# Одноразовый случайный секрет для мастера первоначальной настройки.
DEPLOYCORE_SETUP_TOKEN=

# Каталог MSI/EXE. Лимит серверного прокси — 2048 MiB.
DEPLOYCORE_PACKAGE_MAX_MIB=1024
DEPLOYCORE_PACKAGE_RESERVE_MIB=256
# При необходимости укажите путь к PEM-цепочке внутри контейнера server.
DEPLOYCORE_PACKAGE_CA_FILE=

# Включайте на экземпляре, предназначенном для проверенных операций управления ПО.
DEPLOYCORE_ENABLE_EXECUTION=0
